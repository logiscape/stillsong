{
  "manifestVersion": "2026.09.03-1",
  "notes": "Every artifact Stillsong downloads at first run, pinned by exact URL + size + sha256 — models, runtimes, the CPython build, uv, and every Python wheel (python.wheels, generated by scripts/lock-python.mjs; never edit that section by hand). Setup fetches exactly these blobs with the Rust downloader and installs the Python environment offline from the verified wheelhouse; no resolver ever runs on a user's machine. GitHub source tarballs are commit-pinned; if GitHub ever regenerates them the sha256 check fails loudly and this manifest gets a refresh — never weaken the check. allowedHosts is where a download may START: every pinned URL must be https on one of these hosts (a leading '*.' entry would match subdomains). Redirects issued by those hosts are followed to any https URL — CDN hostnames change between releases and the app never updates itself, so pinning them would only break setup; the pinned size + sha256 is what guarantees the bytes, whichever host serves them.",
  "allowedHosts": [
    "huggingface.co",
    "github.com",
    "files.pythonhosted.org",
    "download-r2.pytorch.org"
  ],
  "python": {
    "version": "3.12.14",
    "notes": "Exact interpreter (the python-dist item below) and the wheel set resolved once at release time from ComfyUI's pinned requirements.txt. `constraints` is hand-maintained: it holds the versions this stack was validated on wherever ComfyUI leaves a requirement open (torch is the one that matters for bit-identical codes). `exclude` is hand-maintained too: packages ComfyUI's requirements resolve but Stillsong deliberately does not ship — today the workflow-template media bundles (sample images/videos for the web frontend's template gallery, which a headless ComfyUI never serves; their absence only disables the /templates route with one logged error at boot). The lock script drops them after resolution and refuses a name the resolution does not contain. Regenerate everything below with `npm run lock:python` after every ComfyUI bump or constraint/exclude change (`--freeze` keeps every other pin where it is).",
    "constraints": [
      "torch==2.13.0+cu130"
    ],
    "exclude": [
      "comfyui-workflow-templates-media-api",
      "comfyui-workflow-templates-media-video",
      "comfyui-workflow-templates-media-image",
      "comfyui-workflow-templates-media-other",
      "comfyui-workflow-templates-media-assets-01"
    ],
    "lockedAt": "2026-09-10",
    "lockedWith": "uv 0.12.6",
    "requirementsSha256": "aa30cb9f42f82cbef885ffa474a6f76f39963d3fab5274aeca8e17c3cc51f13c",
