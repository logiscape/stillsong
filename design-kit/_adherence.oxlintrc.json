{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/media/**",
              "ui_kits/stillsong-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Source Sans 3|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Source Sans 3, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|mono|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, mono, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brass|glass|sage|amber|clay)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brass' | 'glass' | 'sage' | 'amber' | 'clay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|fullWidth|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, fullWidth, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, footer, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|open|onToggle|defaultOpen|children|style|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: summary, open, onToggle, defaultOpen, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|iconSize|variant|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, iconSize, variant, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|surface|glass|brass)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'surface' | 'glass' | 'brass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LintItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|message|key|ref|className|style|children)$/]",
        "message": "<LintItem> doesn't accept that prop. Declared props: level, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='LintItem'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:error|warn)$/]",
        "message": "<LintItem> level must be one of 'error' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LyricSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|stanzas|epigraph|instrumental|mode|style|key|ref|className|style|children)$/]",
        "message": "<LyricSheet> doesn't accept that prop. Declared props: title, stanzas, epigraph, instrumental, mode, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LyricSheet'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:blur|solid)$/]",
        "message": "<LyricSheet> mode must be one of 'blur' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|action|onAction|glass|style|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: tone, title, children, action, onAction, glass, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|calm|warn|error)$/]",
        "message": "<Notice> tone must be one of 'info' | 'calm' | 'warn' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|pad|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: variant, pad, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:matte|inset|glass|solid|quiet)$/]",
        "message": "<Panel> variant must be one of 'matte' | 'inset' | 'glass' | 'solid' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoRoom'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|luminance|scrim|kenBurns|children|style|key|ref|className|style|children)$/]",
        "message": "<PhotoRoom> doesn't accept that prop. Declared props: photo, luminance, scrim, kenBurns, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoRoom'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:radial|vertical|none)$/]",
        "message": "<PhotoRoom> scrim must be one of 'radial' | 'vertical' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoWell'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|dragging|onChoose|onClear|onDraw|onEditDrawing|height|style|key|ref|className|style|children)$/]",
        "message": "<PhotoWell> doesn't accept that prop. Declared props: src, dragging, onChoose, onClear, onDraw, onEditDrawing, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Player'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|position|duration|volume|onToggle|onSeek|onVolume|variant|style|key|ref|className|style|children)$/]",
        "message": "<Player> doesn't accept that prop. Declared props: playing, position, duration, volume, onToggle, onSeek, onVolume, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Player'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glass|matte)$/]",
        "message": "<Player> variant must be one of 'glass' | 'matte'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|detail|indeterminate|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, detail, indeterminate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedChoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|options|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedChoice> doesn't accept that prop. Declared props: label, value, onChange, options, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|options|id|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, value, onChange, options, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|label|width|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, onChange, label, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SongCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|title|genre|length|date|instrumental|versions|playing|onPlay|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<SongCard> doesn't accept that prop. Declared props: photo, title, genre, length, date, instrumental, versions, playing, onPlay, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<Stage> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|hint|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|onChange|placeholder|multiline|rows|mono|invalid|id|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, value, onChange, placeholder, multiline, rows, mono, invalid, id, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "**/screens/draw/palette.ts",
        "**/screens/draw/paintEngine.ts"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ],
